<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.klansistemi</groupId>
    <artifactId>KlanSistemi</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PlaceholderAPI (isteğe bağlı: sunucuda kuruluysa %klan_...% değerleri sunulur) -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
        <!-- GriefPrevention3D (claim içleri prestij için güvenli bölge sayılır) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <!-- LibsDisguises'in kendi resmi Maven deposu (Vahşi Kale nöbetçi NPC'lerini giydirmek için) -->
        <repository>
            <id>libsdisguises-repo</id>
            <url>https://mvn.lib.co.nz/public/</url>
        </repository>
        <!-- PacketEvents: LibsDisguises'in içeride kullandığı sınıflar (derleme için gerekli) -->
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.129-stable</version>
            <scope>provided</scope>
        </dependency>
        <!-- Banka ve sağlık köprüsü (MeslekAPI). Yerelde/CI'da Meslek-Sistemi "mvn install" ile kurulur. -->
        <dependency>
            <groupId>me.mesleksistemi</groupId>
            <artifactId>MeslekSistemi</artifactId>
            <version>1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.12.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.castledking</groupId>
            <artifactId>GriefPrevention3D</artifactId>
            <version>18.4.8</version>
            <scope>provided</scope>
        </dependency>
        <!-- LibsDisguises: Vahşi Kale nöbetçi/lider NPC'lerini (Vindicator mob'u üzerine) insan görünümüne büründürmek için.
             Sunucuda zaten kurulu (Meslek-Sistemi pazar standı NPC'leri de kullanıyor), burada sadece derleme için gerekli. -->
        <dependency>
            <groupId>me.libraryaddict.disguises</groupId>
            <artifactId>libsdisguises</artifactId>
            <version>11.0.13</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.14.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- SQLite JDBC: Vahşi Kale verisi (kale/nöbetçi/sandık kayıtları) config.yml yerine burada tutulur.
             Jar'ın içine GÖMÜLMEZ (maven-shade-plugin'in bağlı ASM sürümü Java 25'in ürettiği class
             dosyalarını (major version 69) henüz desteklemiyor - "Unsupported class file major version 69"
             hatası verdi). Bunun yerine Paper'ın plugin.yml "libraries" özelliği kullanılıyor: sunucu
             açılışta bu kütüphaneyi Maven Central'dan kendi izole classloader'ına indirir, shade'e gerek kalmaz. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
        </plugins>
    </build>
</project>
